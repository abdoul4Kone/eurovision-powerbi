		lineageTag: 7a4e4c36-d1ec-508b-b1f4-3f8b88e0ff53

	measure 'Vue pays · valeur' = IF(HASONEVALUE(dim_editions[edition]), [Rang en finale · pays], IF([Top 10 en finale] > 0, [Top 10 en finale]))
		formatString: 0
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 123f9964-832e-5e2b-8210-25c253f39acb

	measure 'Vue pays · ordre' = IF(HASONEVALUE(dim_editions[edition]), [Rang en finale · pays], RANKX(ALLSELECTED(dim_pays), [Top 10 en finale], , DESC, DENSE))
		formatString: 0
		isHidden
