		lineageTag: 499cc552-97ec-55e5-ad71-e6c2e95247ad

	measure 'Points · étape' = IF(HASONEVALUE(faits_participations[participation_id]), SELECTEDVALUE(faits_resultats[points]))
		formatString: #,0
		displayFolder: Résultats
		lineageTag: 28b77917-c19b-5c82-9c3d-e7112b138660

	/// Garde globale pour la photographie : tient compte des segments, indépendamment de la ligne image.
	measure 'Portrait affichable' =
			VAR Nombre = CALCULATE(DISTINCTCOUNT(faits_participations[participation_id]), ALLSELECTED(dim_participations))
			RETURN IF(Nombre = 1 && COUNTROWS(faits_participations) > 0, 1, BLANK())
		formatString: 0
		displayFolder: Artistes & chansons
		lineageTag: 44d7ce09-5896-448e-8b89-8b88234ce17b

	/// Nombre de classements de 1 à 10 en finale, sans compter les demi-finales.
	measure 'Top 10 en finale' = COALESCE(CALCULATE(COUNTROWS(faits_resultats), KEEPFILTERS(faits_resultats[est_finale] = TRUE()), KEEPFILTERS(faits_resultats[place] <= 10)), 0)
		formatString: 0
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 32c9576a-a756-52f8-874a-7fb9e146b6eb

	/// Dénominateur : toutes les participations du pays dans la sélection, y compris celles sans finale.
	measure 'Part des participations dans le Top 10' = DIVIDE([Top 10 en finale], [Participations])
		formatString: 0.0%
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: c39e69f1-b160-540e-8e78-9306b944931f

	/// Rang uniquement lorsqu’une seule édition et un seul résultat de finale sont identifiés.
	measure 'Rang en finale · pays' = IF(HASONEVALUE(dim_editions[edition]), CALCULATE(SELECTEDVALUE(faits_resultats[place]), KEEPFILTERS(faits_resultats[est_finale] = TRUE())))
		formatString: 0
