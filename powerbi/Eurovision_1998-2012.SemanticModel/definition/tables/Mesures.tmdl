	measure 'Profil · note' = IF(HASONEVALUE(faits_participations[participation_id]), "Indices de 0 à 1 · - = non renseigné · zéros observés conservés", "Sélectionnez une participation pour afficher son profil")
		displayFolder: Artistes & chansons
		lineageTag: 4f7331f6-8152-5689-8775-efb343f5e713

	measure 'Rang · étape' = IF(HASONEVALUE(faits_participations[participation_id]), SELECTEDVALUE(faits_resultats[place]))
		formatString: 0
