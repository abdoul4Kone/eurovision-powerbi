table Mesures
	lineageTag: 8eeb3306-7b35-5cd0-b0c2-8fbb9325c982

	measure Éditions = COALESCE(DISTINCTCOUNT(faits_participations[edition]), 0)
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: f68dc52d-256e-5934-83aa-c77222edffc9

	measure 'Pays représentés' = COALESCE(DISTINCTCOUNT(faits_participations[pays_id]), 0)
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: c096fcb7-e3d4-514f-ac41-659fcb465e97

	/// Une ligne par pays et édition, sans double comptage des passages.
	measure Participations = COALESCE(COUNTROWS(faits_participations), 0)
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: 6789c999-3530-50a4-947b-4497fdac2fe1

	measure 'Passages en finale' = COALESCE(CALCULATE(COUNTROWS(faits_resultats), KEEPFILTERS(faits_resultats[est_finale] = TRUE())), 0)
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: 5555bdd7-67a0-528b-8b20-3521b093bf88

	measure 'Pays en finale' = CALCULATE(DISTINCTCOUNT(faits_resultats[pays_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: 2fc5b988-8089-5e76-a9df-6dcf6a8a25fd

	measure Victoires = CALCULATE(COUNTROWS(faits_resultats), KEEPFILTERS(faits_resultats[est_finale] = TRUE()), KEEPFILTERS(faits_resultats[place] = 1))
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: d9262485-f70f-5bcc-8682-e51e20b5ad36

	measure 'Pays en tête' =
			VAR Classement = FILTER(ADDCOLUMNS(VALUES(dim_pays[pays_fr]), "__Victoires", [Victoires]), [__Victoires] > 0)
			VAR Maximum = MAXX(Classement, [__Victoires])
			VAR Leaders = FILTER(Classement, [__Victoires] = Maximum)
			RETURN IF(COUNTROWS(Leaders) = 0, "Aucune victoire", IF(COUNTROWS(Leaders) > 1, FORMAT(COUNTROWS(Leaders), "0") & " pays à égalité", CONCATENATEX(Leaders, dim_pays[pays_fr], ", ")))
		displayFolder: Vue d’ensemble
		lineageTag: 5bd8e8a4-8a7c-52d8-b096-c757e5181dfe

	measure 'Victoires en tête' =
			VAR Classement = ADDCOLUMNS(VALUES(dim_pays[pays_fr]), "__Victoires", [Victoires])
			RETURN COALESCE(MAXX(Classement, [__Victoires]), 0)
		formatString: #,0
		displayFolder: Vue d’ensemble
		lineageTag: 32a367bf-1b61-59a5-91d8-5d5d513a8259

	measure 'Contexte du palmarès' =
			VAR Nombre = [Victoires en tête]
			VAR Gagnants = [Victoires]
			RETURN IF(Nombre = 0, "Aucune première place en finale dans cette sélection.", FORMAT(Nombre, "0") & IF(Nombre = 1, " victoire", " victoires") & " sur " & FORMAT(Gagnants, "0") & IF(Gagnants = 1, " finale remportée dans la sélection.", " finales remportées dans la sélection."))
		displayFolder: Vue d’ensemble
		lineageTag: 95bbd474-8834-5231-9f88-df85eeea5bea

	/// Finalistes renseignés seulement ; aucune valeur manquante remplacée par zéro.
	measure 'Énergie moyenne' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[energy]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])))
		formatString: 0.00
		displayFolder: Musique
		lineageTag: cc603396-a59c-588d-a109-385a8a67eb8f

	/// Finalistes renseignés seulement ; aucune valeur manquante remplacée par zéro.
	measure 'Dansabilité moyenne' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[danceability]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])))
		formatString: 0.00
		displayFolder: Musique
		lineageTag: 2611f6b2-2337-52bf-bc3d-0ee1e1cb0a83

	/// Finalistes renseignés seulement ; aucune valeur manquante remplacée par zéro.
	measure 'Tempo moyen' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[tempo]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])))
		formatString: 0.0
		displayFolder: Musique
		lineageTag: a6d185bc-31c1-5251-9a3f-0df2ff9cdf0f

	measure 'Finalistes documentés' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN COALESCE(CALCULATE(COUNTROWS(faits_participations), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])), KEEPFILTERS(FILTER(faits_participations, NOT ISBLANK(faits_participations[energy]) && NOT ISBLANK(faits_participations[danceability]) && NOT ISBLANK(faits_participations[tempo])))), 0)
		formatString: #,0
		displayFolder: Musique
		lineageTag: d3821b77-6948-5073-94f1-7be6ab1c55ae

	measure 'Couverture acoustique' = DIVIDE([Finalistes documentés], [Passages en finale])
		formatString: 0%
		displayFolder: Musique
		lineageTag: b8455a66-6ea9-5483-b307-f8453419b1a3

	measure 'Finalistes documentés · affichage' = FORMAT([Finalistes documentés], "0") & " / " & FORMAT([Passages en finale], "0")
		displayFolder: Musique
		lineageTag: ed710fa4-1fd4-552e-84d4-43a1aff38aad

	measure 'Couverture · affichage' = IF([Passages en finale] = 0, "Aucun finaliste dans la sélection", FORMAT([Couverture acoustique], "0%") & " de la sélection documentée")
		displayFolder: Musique
		lineageTag: 83d994d9-f308-55ef-9faf-a73c918ce487

	measure 'Profils complets' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN COALESCE(CALCULATE(COUNTROWS(faits_participations), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE())), 0)
		formatString: #,0
		displayFolder: Musique
		lineageTag: 853c3f13-a2af-5103-9752-e3308a347d7a

	measure 'Profils · affichage' = FORMAT([Profils complets], "0") & " profils complets · énergie, dansabilité et acousticité"
		displayFolder: Musique
		lineageTag: 88b6453a-dfe2-5e40-9c71-1ce7c675013f

	/// Même échantillon de finalistes complets pour les trois indices du profil.
	measure 'Énergie · profil' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[energy]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique
		lineageTag: f8459b33-c28d-52be-91ea-64dc2636a434

	/// Même échantillon de finalistes complets pour les trois indices du profil.
	measure 'Dansabilité · profil' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[danceability]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique
		lineageTag: 0b13c781-e3cc-53bd-8c80-594d8b6b27e9

	/// Même échantillon de finalistes complets pour les trois indices du profil.
	measure 'Acoustique · profil' =
			VAR IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(AVERAGE(faits_participations[acousticness]), KEEPFILTERS(TREATAS(IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique
		lineageTag: 5108bc89-3a71-5089-8b3d-b400345f7b79

	/// Ratio pré-calculé sur la finale entière ; le dénominateur ne change pas avec les filtres du rapport.
	measure 'Part des points en finale' = CALCULATE(AVERAGE(faits_resultats[part_points_etape]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
		formatString: 0.0%
		displayFolder: Musique
		lineageTag: 8ff6c8a3-e495-561a-a032-56ac99bdd68d

	measure 'Points en finale' = CALCULATE(SUM(faits_resultats[points]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
		formatString: #,0
		displayFolder: Résultats
		lineageTag: a9c9b7bf-63b8-5ec9-b432-03ec21ffa6a9

	measure 'Points reçus en finale' = SUM(faits_votes[points])
		formatString: #,0
		displayFolder: Votes
		lineageTag: e0c2796e-fca8-5b2e-8235-b7c1652940af

	measure 'Artiste sélectionné' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Choisir un artiste", COALESCE(LOOKUPVALUE(dim_participations[artiste], dim_participations[participation_id], __SelectionId), "Choisir un artiste"))
		displayFolder: Artistes & chansons
		lineageTag: ab173fc5-5fa4-55ac-b493-9485dac439b2

	measure 'Participations de l’artiste' = COALESCE(COUNTROWS(faits_participations), 0)
		formatString: #,0
		displayFolder: Artistes & chansons
		lineageTag: ef89d1ad-ce32-5e49-a837-251e9fddb67d

	measure 'Pays de l’artiste' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "-", COALESCE(LOOKUPVALUE(dim_participations[pays_fr], dim_participations[participation_id], __SelectionId), "-"))
		displayFolder: Artistes & chansons
		lineageTag: 4b1cc55c-4442-552a-a58a-23bcf72230ce

	measure 'Genre renseigné' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Non renseigné", COALESCE(LOOKUPVALUE(dim_participations[genre_source], dim_participations[participation_id], __SelectionId), "Non renseigné"))
		displayFolder: Artistes & chansons
		lineageTag: 35830488-6c0d-5151-aca2-90a8ba8edd68

	/// Vide si la sélection ne désigne pas un classement de finale unique.
	measure 'Classement en finale' = CALCULATE(SELECTEDVALUE(faits_resultats[place]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
		formatString: 0
		displayFolder: Artistes
		lineageTag: 81b6aca6-a85f-53d0-bfef-a7f6f32e8ab5

	measure 'Chanson sélectionnée' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Dans le filtre Participation", COALESCE(LOOKUPVALUE(dim_participations[chanson], dim_participations[participation_id], __SelectionId), "Dans le filtre Participation"))
		displayFolder: Artistes & chansons
		lineageTag: 76f9e758-77eb-5ac0-91cf-8d066b04a0bb

	measure 'Formation sélectionnée' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Non renseignée", SWITCH(LOOKUPVALUE(dim_participations[formation_source], dim_participations[participation_id], __SelectionId), "Solo", "Soliste", "Group", "Groupe", "Non renseignée"))
		displayFolder: Artistes & chansons
		lineageTag: 835d837b-3e73-515a-8494-d8b054cfe4aa

	measure 'Portrait sélectionné' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			VAR __Neutre = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 354 268'><rect width='354' height='268' fill='%2310182B'/><g transform='translate(153 110)' fill='none' stroke='%23627694' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'><rect x='17' y='2' width='14' height='28' rx='7'/><path d='M10 23v3a14 14 0 0 0 28 0v-3M24 40v8M16 48h16'/></g></svg>"
			RETURN IF(ISBLANK(__SelectionId), __Neutre, COALESCE(LOOKUPVALUE(dim_participations[image_url], dim_participations[participation_id], __SelectionId), __Neutre))
		displayFolder: Artistes & chansons
		lineageTag: a9211893-6938-5903-a982-21a8367a5cb2
		dataCategory: ImageUrl

	measure 'Crédit du portrait' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Auteur non renseigné", COALESCE(LOOKUPVALUE(dim_participations[image_auteur], dim_participations[participation_id], __SelectionId), "Auteur non renseigné"))
		displayFolder: Artistes & chansons
		lineageTag: 0346adfc-3f60-534a-870a-8250865365f2

	measure 'Source du portrait' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "", COALESCE(LOOKUPVALUE(dim_participations[image_source], dim_participations[participation_id], __SelectionId), ""))
		displayFolder: Artistes & chansons
		lineageTag: 62165cb3-2f38-5918-842f-89fa6126d22f

	measure 'Licence du portrait' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "Licence non renseignée", COALESCE(LOOKUPVALUE(dim_participations[image_licence], dim_participations[participation_id], __SelectionId), "Licence non renseignée"))
		displayFolder: Artistes & chansons
		lineageTag: d78d87a2-8beb-5b54-a165-41e519dc6cd6

	measure 'Participation disponible' = IF(COUNTROWS(faits_participations) > 0, 1, BLANK())
		formatString: 0
		displayFolder: Artistes & chansons
		lineageTag: 5b4035f4-be74-515f-a714-f0350ebab615

	measure 'Édition sélectionnée' = IF(HASONEVALUE(faits_participations[participation_id]), FORMAT(SELECTEDVALUE(faits_participations[edition]), "0"), "-")
		displayFolder: Artistes & chansons
		lineageTag: 73842374-51fa-5b07-a302-bf2d02f9b8f6

	measure 'Contexte de la sélection' =
			VAR N = COUNTROWS(faits_participations)
			RETURN SWITCH(TRUE(), N = 0, "Aucune participation pour ces filtres. Effacez la sélection pour continuer.", N = 1, "Une participation · une chanson · un pays", FORMAT(N, "0") & " participations disponibles · choisissez une chanson")
		displayFolder: Artistes & chansons
		lineageTag: 34ce051f-a833-5e79-bb6c-618aa20c5509

	measure 'Résultat sélectionné' =
			VAR N = COUNTROWS(faits_participations)
			VAR Finaliste = SELECTEDVALUE(faits_participations[est_finaliste])
			VAR Rang = CALCULATE(SELECTEDVALUE(faits_resultats[place]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN IF(N <> 1, "-", IF(Finaliste, FORMAT(Rang, "0") & IF(Rang = 1, "er", "e") & " en finale", "Demi-finale"))
		displayFolder: Artistes & chansons
		lineageTag: 72f9ccd3-77c3-5695-826b-515d1a8ab21d

	measure 'Points · artiste' = IF(HASONEVALUE(faits_participations[participation_id]), IF(SELECTEDVALUE(faits_participations[est_finaliste]), FORMAT([Points en finale], "0"), "-"), "-")
		displayFolder: Artistes & chansons
		lineageTag: dd169e78-3e91-5ec0-876c-51d5c0b45912

	measure 'Statut · artiste' = IF(HASONEVALUE(faits_participations[participation_id]), IF(SELECTEDVALUE(faits_participations[est_finaliste]), "FINALISTE", "DEMI-FINALISTE"), "À EXPLORER")
		displayFolder: Artistes & chansons
		lineageTag: 809c2a4d-3856-5d14-bf6c-b8501f507a13

	measure 'Portrait · provenance' = IF(HASONEVALUE(faits_participations[participation_id]), [Crédit du portrait] & " · " & [Licence du portrait], "Sources et licences dans le catalogue photo")
		displayFolder: Artistes & chansons
		lineageTag: 87fb2268-c30e-5f1c-a274-460b36c3b236

	/// Participation unique ; absence conservée, zéro authentique conservé.
	measure 'Énergie · artiste' = IF(HASONEVALUE(faits_participations[participation_id]), SELECTEDVALUE(faits_participations[energy]))
		formatString: 0.00
		displayFolder: Artistes & chansons
		lineageTag: 3c4ab67f-2534-5cae-80ed-9099952546ad

	/// Participation unique ; absence conservée, zéro authentique conservé.
	measure 'Dansabilité · artiste' = IF(HASONEVALUE(faits_participations[participation_id]), SELECTEDVALUE(faits_participations[danceability]))
		formatString: 0.00
		displayFolder: Artistes & chansons
		lineageTag: 8c2c299c-2f10-5aca-bcbd-899aab4e650d

	/// Participation unique ; absence conservée, zéro authentique conservé.
	measure 'Acousticité · artiste' = IF(HASONEVALUE(faits_participations[participation_id]), SELECTEDVALUE(faits_participations[acousticness]))
		formatString: 0.00
		displayFolder: Artistes & chansons
		lineageTag: ceb27a9f-5bd1-5d70-8b4b-48aeed9051b5

	measure 'Énergie · texte' =
			VAR N = COUNTROWS(faits_participations)
			VAR Valeur = SELECTEDVALUE(faits_participations[energy])
			RETURN IF(N <> 1, "-", IF(ISBLANK(Valeur), "-", FORMAT(Valeur, "0.00", "fr-FR")))
		displayFolder: Artistes & chansons
		lineageTag: 153b6132-ca78-5375-9d87-3ba219f8130a

	measure 'Dansabilité · texte' =
			VAR N = COUNTROWS(faits_participations)
			VAR Valeur = SELECTEDVALUE(faits_participations[danceability])
			RETURN IF(N <> 1, "-", IF(ISBLANK(Valeur), "-", FORMAT(Valeur, "0.00", "fr-FR")))
		displayFolder: Artistes & chansons
