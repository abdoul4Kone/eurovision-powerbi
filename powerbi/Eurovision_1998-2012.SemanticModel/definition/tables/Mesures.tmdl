		lineageTag: 21ff66dc-dd9e-58cc-82cb-1ee4fe50fe83

	/// Plusieurs éditions : dix pays au plus, égalités départagées par nom français puis clé. Une édition : tous les finalistes.
	measure 'Vue pays · affichable' =
			VAR UneEdition = HASONEVALUE(dim_editions[edition])
			VAR PaysActuel = SELECTEDVALUE(dim_pays[pays_id])
			VAR Candidats = FILTER(ADDCOLUMNS(ALLSELECTED(dim_pays), "__Nombre", [Top 10 en finale]), [__Nombre] > 0)
			VAR DixPays = TOPN(10, Candidats, [__Nombre], DESC, dim_pays[pays_fr], ASC, dim_pays[pays_id], ASC)
			RETURN IF(UneEdition, IF(NOT ISBLANK([Rang en finale · pays]), 1), IF(CONTAINS(DixPays, dim_pays[pays_id], PaysActuel), 1))
		formatString: 0
		isHidden
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 4843012b-8feb-552b-af2b-5442b680f080

	measure 'Vue pays · titre' = IF(HASONEVALUE(dim_editions[edition]), "Le classement des finalistes · " & FORMAT(SELECTEDVALUE(dim_editions[edition]), "0"), "Les pays les plus souvent dans le Top 10")
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: f3571ee1-249e-5356-a358-92070ed2078e

	measure 'Vue pays · sous-titre' =
			SWITCH(TRUE(),
			[Passages en finale] = 0, "Aucune finale dans la sélection · élargissez les filtres",
			HASONEVALUE(dim_editions[edition]), "Rang final · 1 = meilleure place · défilez pour voir tous les pays",
			[Top 10 en finale] = 0, "Aucun classement dans le Top 10 pour les pays et éditions sélectionnés",
			"Les 10 premiers pays · nombre de classements en finale de 1 à 10")
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 60e4d2ef-e01d-5258-93df-eddb264febea

	measure 'Périmètre · éditions' =
			VAR N = [Éditions]
			RETURN FORMAT(N, "0") & IF(N = 1, " édition représentée", " éditions représentées")
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 47459a49-92bb-5810-b4e7-4bb2c8ac832f

	/// Maximum de la part pré-calculée sur la finale entière ; ce dénominateur est conservé lorsque les pays sont filtrés.
	measure 'Performance · part maximale' = CALCULATE(MAX(faits_resultats[part_points_etape]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
		formatString: 0.0%
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: ca365229-c4b7-5c87-bcaa-35b42994e095

	measure 'Performance · nombre' =
			VAR Maximum = [Performance · part maximale]
			RETURN IF(ISBLANK(Maximum), 0, COUNTROWS(FILTER(faits_resultats, faits_resultats[est_finale] = TRUE() && ABS(faits_resultats[part_points_etape] - Maximum) < 0.000000000001)))
		formatString: 0
		isHidden
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: dea7fb43-b4f0-5f7b-8663-80af5d28b497

	measure 'Performance · participation' =
			VAR Maximum = [Performance · part maximale]
			VAR Leaders = FILTER(faits_resultats, faits_resultats[est_finale] = TRUE() && ABS(faits_resultats[part_points_etape] - Maximum) < 0.000000000001)
			RETURN IF([Performance · nombre] = 1, MAXX(Leaders, faits_resultats[participation_id]))
		isHidden
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 77651296-1c05-5544-a2f6-f908d5762de6

	measure 'Performance · artiste' =
			VAR __SelectionId = [Performance · participation]
			VAR Nombre = [Performance · nombre]
			RETURN SWITCH(TRUE(), Nombre = 0, "Aucune finale", Nombre > 1, FORMAT(Nombre, "0") & " chansons à égalité", LOOKUPVALUE(dim_participations[artiste], dim_participations[participation_id], __SelectionId))
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 085c3b65-5861-5a01-8d20-12cea4647d9d

	measure 'Performance · chanson' =
			VAR __SelectionId = [Performance · participation]
			RETURN IF(NOT ISBLANK(__SelectionId), LOOKUPVALUE(dim_participations[chanson], dim_participations[participation_id], __SelectionId))
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 72f31c24-ecea-57ef-8c34-a470e770e367

	measure 'Performance · part affichée' =
			VAR Part = [Performance · part maximale]
			RETURN IF(ISBLANK(Part), "-", FORMAT(Part, "0.0 %", "fr-FR"))
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 3dc37c2f-437e-5ca5-9555-c49c1bb2a1b0

	measure 'Performance · contexte' =
			VAR __SelectionId = [Performance · participation]
			VAR Pays = LOOKUPVALUE(dim_participations[pays_fr], dim_participations[participation_id], __SelectionId)
			VAR Annee = LOOKUPVALUE(dim_participations[edition], dim_participations[participation_id], __SelectionId)
			VAR Points = CALCULATE(SELECTEDVALUE(faits_resultats[points]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()), KEEPFILTERS(TREATAS({__SelectionId}, faits_resultats[participation_id])))
			RETURN SWITCH(TRUE(), [Performance · nombre] = 0, "Élargissez les filtres pour explorer les chansons.", [Performance · nombre] > 1, "Plusieurs chansons partagent la même part maximale des points.", Pays & " · " & FORMAT(Annee, "0") & UNICHAR(10) & FORMAT(Points, "#,0", "fr-FR") & " points en finale")
		displayFolder: Vue d’ensemble\Indicateurs
		lineageTag: 488f765c-32c4-57d8-ba5c-6f99df259718

	/// Finalistes avec énergie, dansabilité et acousticité / tous les finalistes de la sélection.
	measure 'Couverture · profils complets' = DIVIDE([Profils complets], [Passages en finale])
		formatString: 0.0%
		displayFolder: Musique\Indicateurs revus
		lineageTag: 3f741b5a-5b4f-5350-905c-8bb36ab51dab

	measure 'Profils complets · affichage' = FORMAT([Profils complets], "0") & " / " & FORMAT([Passages en finale], "0")
		displayFolder: Musique\Indicateurs revus
		lineageTag: 6fccc4e5-9bf7-5509-8159-baf1595014a8

	measure 'Couverture · profils affichage' = IF([Passages en finale] = 0, "Aucun finaliste dans la sélection", FORMAT([Couverture · profils complets], "0 %", "fr-FR") & " des finalistes sélectionnés")
		displayFolder: Musique\Indicateurs revus
		lineageTag: 91def2ca-d81e-5fa2-a678-72ddaea4e584

	measure 'Effectifs · profils par groupe' =
			VAR __TopN = CALCULATE([Profils complets], KEEPFILTERS(faits_resultats[groupe_classement] = "Top 10"))
			VAR __TopTotal = CALCULATE([Passages en finale], KEEPFILTERS(faits_resultats[groupe_classement] = "Top 10"))
			VAR __AutresN = CALCULATE([Profils complets], KEEPFILTERS(faits_resultats[groupe_classement] = "Autres finalistes"))
			VAR __AutresTotal = CALCULATE([Passages en finale], KEEPFILTERS(faits_resultats[groupe_classement] = "Autres finalistes"))
			RETURN "Top 10 : " & FORMAT(__TopN, "0") & "/" & FORMAT(__TopTotal, "0") & " · Autres : " & FORMAT(__AutresN, "0") & "/" & FORMAT(__AutresTotal, "0")
		displayFolder: Musique\Indicateurs revus
		lineageTag: 2f7355f8-9075-54f9-9f37-d373935026c5

	measure 'Énergie · profil affichage' =
			VAR __Valeur = [Énergie · profil]
			RETURN IF(ISBLANK(__Valeur), "-", FORMAT(__Valeur, "0.00", "fr-FR"))
		displayFolder: Musique\Indicateurs revus
		lineageTag: a6f982ec-fb89-500b-b68c-0b135bb5f442

	/// Médiane sur le même échantillon complet que les trois moyennes ; disponible en infobulle.
	measure 'Énergie médiane · profils' =
			VAR __IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(MEDIAN(faits_participations[energy]), KEEPFILTERS(TREATAS(__IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique\Indicateurs revus
		lineageTag: 564a7c06-eac2-5bc2-b2eb-77e2328b2529

	measure 'Dansabilité · profil affichage' =
			VAR __Valeur = [Dansabilité · profil]
			RETURN IF(ISBLANK(__Valeur), "-", FORMAT(__Valeur, "0.00", "fr-FR"))
		displayFolder: Musique\Indicateurs revus
		lineageTag: dc1ce5c0-7aec-5edd-bb87-03a7424b1b5a

	/// Médiane sur le même échantillon complet que les trois moyennes ; disponible en infobulle.
	measure 'Dansabilité médiane · profils' =
			VAR __IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(MEDIAN(faits_participations[danceability]), KEEPFILTERS(TREATAS(__IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique\Indicateurs revus
		lineageTag: 874dc4fa-3c0f-58ce-88c2-72745c695d3a

	measure 'Acousticité · profil affichage' =
			VAR __Valeur = [Acoustique · profil]
			RETURN IF(ISBLANK(__Valeur), "-", FORMAT(__Valeur, "0.00", "fr-FR"))
		displayFolder: Musique\Indicateurs revus
		lineageTag: 3b8a6b24-ebb5-5f89-a7a3-a4c642488028

	/// Médiane sur le même échantillon complet que les trois moyennes ; disponible en infobulle.
	measure 'Acousticité médiane · profils' =
			VAR __IdsFinale = CALCULATETABLE(VALUES(faits_resultats[participation_id]), KEEPFILTERS(faits_resultats[est_finale] = TRUE()))
			RETURN CALCULATE(MEDIAN(faits_participations[acousticness]), KEEPFILTERS(TREATAS(__IdsFinale, faits_participations[participation_id])), KEEPFILTERS(faits_participations[profil_complet] = TRUE()))
		formatString: 0.00
		displayFolder: Musique\Indicateurs revus
		lineageTag: 69b8a566-8ad8-50e8-943a-632c87f0eb15

	measure 'Candidature · pays et année' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			RETURN IF(ISBLANK(__SelectionId), "-", LOOKUPVALUE(dim_participations[pays_fr], dim_participations[participation_id], __SelectionId) & " · " & FORMAT(SELECTEDVALUE(faits_participations[edition]), "0"))
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 67504cc2-338d-5282-8d5c-f5bf2efba537

	/// Dénominateur de rang : tous les finalistes de l’édition, indépendamment du pays sélectionné.
	measure 'Finalistes · édition de la candidature' =
			VAR __SelectionId = SELECTEDVALUE(faits_participations[participation_id])
			VAR __Annee = SELECTEDVALUE(faits_participations[edition])
			RETURN IF(NOT ISBLANK(__SelectionId), CALCULATE(COUNTROWS(faits_resultats), REMOVEFILTERS(), TREATAS({__Annee}, dim_editions[edition]), faits_resultats[est_finale] = TRUE()))
		formatString: 0
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 8ae3dd5d-b5db-5f40-a050-faf4cd522231

	measure 'Rang contextualisé · artiste' =
			VAR __Unique = HASONEVALUE(faits_participations[participation_id])
			VAR __Finaliste = SELECTEDVALUE(faits_participations[est_finaliste])
			VAR __Rang = [Classement en finale]
			RETURN IF(NOT __Unique, "-", IF(NOT __Finaliste, "Demi-finale", IF(ISBLANK(__Rang), "-", FORMAT(__Rang, "0") & IF(__Rang = 1, "er", "e") & " sur " & FORMAT([Finalistes · édition de la candidature], "0"))))
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 11d6c241-ec9a-514b-904b-1940a6790262

	/// Part du total des points de la finale entière ; ni part des votants, ni taux de qualification.
	measure 'Part des points · artiste' = IF(HASONEVALUE(faits_participations[participation_id]) && SELECTEDVALUE(faits_participations[est_finaliste]), [Part des points en finale])
		formatString: 0.0%
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 070892fc-3025-531e-9988-be0f71b0f7ae

	measure 'Part des points · artiste affichage' =
			VAR __Part = [Part des points · artiste]
			RETURN IF(ISBLANK(__Part), "-", FORMAT(__Part, "0.0 %", "fr-FR"))
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 064f9b63-5e6f-5ea4-88c3-93d4c03b09bf

	/// Nombre de valeurs présentes parmi les trois indices, sans transformer un zéro observé en absence.
	measure 'Indices connus · artiste' =
			VAR __Unique = HASONEVALUE(faits_participations[participation_id])
			VAR __Nombre = IF(NOT ISBLANK(SELECTEDVALUE(faits_participations[energy])), 1, 0) + IF(NOT ISBLANK(SELECTEDVALUE(faits_participations[danceability])), 1, 0) + IF(NOT ISBLANK(SELECTEDVALUE(faits_participations[acousticness])), 1, 0)
			RETURN IF(__Unique, __Nombre)
		formatString: 0
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: cdb7573e-65ec-58be-9654-9931abdc2c29

	measure 'Disponibilité · profil artiste' =
			VAR __Nombre = [Indices connus · artiste]
			RETURN IF(ISBLANK(__Nombre), "-", FORMAT(__Nombre, "0") & " / 3")
		displayFolder: Artistes & chansons\Indicateurs revus
		lineageTag: 12693824-861c-59c5-a4f1-ae29b24f45bb

	column Cle
		dataType: int64
		isHidden
		lineageTag: e39f9c85-fa54-44de-901f-92b98744c039
		summarizeBy: none
		sourceColumn: Cle

	partition Mesures = m
		mode: import
		source = #table(type table [Cle = Int64.Type], {{1}})

