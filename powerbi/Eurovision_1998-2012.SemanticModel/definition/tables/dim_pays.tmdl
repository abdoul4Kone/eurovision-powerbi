	partition dim_pays = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "\eurovision_constellation.xlsx"), null, true),
				    Donnees = Table.PromoteHeaders(Source{[Item="dim_pays",Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
