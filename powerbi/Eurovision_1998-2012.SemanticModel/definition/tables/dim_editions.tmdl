	partition dim_editions = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(DossierDonnees & "\eurovision_constellation.xlsx"), null, true),
				    Donnees = Table.PromoteHeaders(Source{[Item="dim_editions",Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
				    Types = Table.TransformColumnTypes(Donnees, {{"edition", Int64.Type}, {"nombre_demi_finales", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table

