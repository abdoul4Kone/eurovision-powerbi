table dim_editions
	lineageTag: b865723d-5fd5-549e-8812-7ca86cdbdb19

	column edition
		dataType: int64
		formatString: 0
		lineageTag: 335b9abe-8b64-5f76-a5af-e3a1ca9f8e84
		summarizeBy: none
		sourceColumn: edition

	column nombre_demi_finales
		dataType: int64
		formatString: #,0
		lineageTag: c8e6fc0b-74ca-5697-833a-b40335622294
		summarizeBy: none
